{
  "name": "@ship-it/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev:web": "vite",
    "dev:server": "npm run dev --workspace server",
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "build:web": "tsc -b && vite build",
    "build:server": "npm run build --workspace server",
    "build": "npm run build:web && npm run build:server",
    "start": "npm run start --workspace server",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "lint": "eslint src/ server/src/ scripts/",
    "lint:fix": "eslint src/ server/src/ scripts/ --fix",
    "verify": "node scripts/verify.mjs",
    "verify:offline": "node scripts/verify.mjs --no-ai"
  },
  "dependencies": {
    "@heroui/react": "^2.6.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10"
  }
}
