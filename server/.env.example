NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase: database, auth and object storage.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
SUPABASE_ANON_KEY=xxx

# Direct Postgres connection string, used by the Go runtime orchestrator.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# HMAC secret for API key hashing. Required in production.
API_KEY_HASH_SECRET=

# Whop. Separate credentials per environment; the wrong set must never be used.
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_PRODUCT_ID=
WHOP_LIVE_API_KEY=
WHOP_LIVE_PRODUCT_ID=
WHOP_WEBHOOK_SECRET=

# GitHub Actions build system.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_REPO=Ship-it-labs/opencode-plugin

# Go runtime orchestrator.
RUNTIME_ORCHESTRATOR_URL=http://localhost:3003
ORCHESTRATOR_SECRET=change-me-in-production

# Frontend build output served on /.
FRONTEND_URL=http://localhost:5173
