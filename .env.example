# No build-time variables are required.
# The site talks to the control plane on the same origin in production,
# so no keys are baked into the bundle.
#
# For a split setup, uncomment and point at the API:
# VITE_API_BASE=http://127.0.0.1:3000

# Pollinations (gen.pollinations.ai) key: powers the in-site assistant and the
# `pnpm verify` failure triage. Server-side only — never ship it to the browser.
POLLINATIONS_API_KEY=
# Optional: a key carrying the `account:usage` scope, so the admin panel can
# read the remaining pollen balance. Falls back to POLLINATIONS_API_KEY.
POLLINATIONS_ACCOUNT_KEY=
POLLINATIONS_MODEL=qwen/qwen3.7-flash
POLLINATIONS_FALLBACK_MODELS=openai/gpt-5.4-nano,openai/gpt-oss-20b

# Assistant credits. A credit is AI_TOKENS_PER_CREDIT tokens (prompt +
# completion). Free gets none; Pro and Ultra get a monthly allowance. Admins are
# unlimited. Cache hits are free.
AI_TOKENS_PER_CREDIT=10000
AI_CREDITS_PRO=50
AI_CREDITS_ULTRA=200
